{
  "name": "LendLoop - Overdue reminders (daily)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 9
            }
          ]
        }
      },
      "name": "Daily 09:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        200
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const crypto = require('crypto');\nconst secret = $env.LENDLOOP_HMAC_SECRET;\nif (!secret) throw new Error('LENDLOOP_HMAC_SECRET is not set in the n8n environment');\n\nconst body = '';\nconst timestamp = String(Math.floor(Date.now() / 1000));\nconst signature = 'sha256=' + crypto.createHmac('sha256', secret).update(timestamp + '.' + body).digest('hex');\nreturn { json: { body, timestamp, signature } };"
      },
      "name": "Sign overdue request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        200
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.LENDLOOP_CONVEX_SITE_URL }}/n8n/overdue-loans",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-lendloop-timestamp",
              "value": "={{ $json.timestamp }}"
            },
            {
              "name": "x-lendloop-signature",
              "value": "={{ $json.signature }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Fetch overdue loans",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        200
      ],
      "retryOnFail": true,
      "maxTries": 4,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return ($input.first().json.loans || []).map(l => ({ json: l }));"
      },
      "name": "One item per loan",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        200
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const l = $json;\nconst message = 'Hi ' + l.borrowerName + ', \"' + l.toolName + '\" was due ' + l.endDate + ' (' + l.daysOverdue + ' day(s) overdue). Please return it to the lender.';\n// Mock delivery: replace with an email/chat node in production.\nconsole.log('[LendLoop reminder]', JSON.stringify({ to: l.borrowerName, message }));\nreturn { json: { loanId: l.loanId, idempotencyKey: l.idempotencyKey, message } };"
      },
      "name": "Send mock reminder",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        200
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const crypto = require('crypto');\nconst secret = $env.LENDLOOP_HMAC_SECRET;\nif (!secret) throw new Error('LENDLOOP_HMAC_SECRET is not set in the n8n environment');\n\nconst body = JSON.stringify({ kind: 'overdue_reminder', idempotencyKey: $json.idempotencyKey, loanId: $json.loanId, status: 'sent', detail: 'Mock reminder logged' });\nconst timestamp = String(Math.floor(Date.now() / 1000));\nconst signature = 'sha256=' + crypto.createHmac('sha256', secret).update(timestamp + '.' + body).digest('hex');\nreturn { json: { body, timestamp, signature } };"
      },
      "name": "Sign write-back",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.LENDLOOP_CONVEX_SITE_URL }}/n8n/automation-events",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-lendloop-timestamp",
              "value": "={{ $json.timestamp }}"
            },
            {
              "name": "x-lendloop-signature",
              "value": "={{ $json.signature }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.body }}",
        "options": {}
      },
      "name": "Write reminder status to Convex",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        200
      ],
      "retryOnFail": true,
      "maxTries": 4,
      "waitBetweenTries": 3000
    }
  ],
  "connections": {
    "Daily 09:00": {
      "main": [
        [
          {
            "node": "Sign overdue request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sign overdue request": {
      "main": [
        [
          {
            "node": "Fetch overdue loans",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch overdue loans": {
      "main": [
        [
          {
            "node": "One item per loan",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "One item per loan": {
      "main": [
        [
          {
            "node": "Send mock reminder",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send mock reminder": {
      "main": [
        [
          {
            "node": "Sign write-back",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sign write-back": {
      "main": [
        [
          {
            "node": "Write reminder status to Convex",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false,
  "pinData": {},
  "tags": []
}
