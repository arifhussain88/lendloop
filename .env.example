# Copy to .env.local (used by Next.js, the Convex CLI and `docker compose --env-file .env.local`).
# Placeholders only. Never commit real values.

# --- Clerk (https://dashboard.clerk.com) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_SECRET_KEY=sk_test_REPLACE_ME
# Issuer of the Clerk "convex" JWT template, e.g. https://your-app.clerk.accounts.dev
# Also set on the Convex deployment: npx convex env set CLERK_JWT_ISSUER_DOMAIN <value>
CLERK_JWT_ISSUER_DOMAIN=https://REPLACE_ME.clerk.accounts.dev

# --- Convex (written by `npx convex dev`) ---
CONVEX_DEPLOYMENT=dev:REPLACE_ME
NEXT_PUBLIC_CONVEX_URL=https://REPLACE_ME.convex.cloud
# HTTP actions base URL (ends in .convex.site) - used by n8n to call back into Convex
LENDLOOP_CONVEX_SITE_URL=https://REPLACE_ME.convex.site

# --- Automation (shared by Convex env and n8n env) ---
# Generate with: openssl rand -hex 32
LENDLOOP_HMAC_SECRET=REPLACE_WITH_RANDOM_HEX
# Public URL of the n8n webhook (set on Convex: npx convex env set N8N_WEBHOOK_URL <value>)
N8N_WEBHOOK_URL=https://REPLACE_ME.example/webhook/lendloop-loan-events

# --- n8n container ---
N8N_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_HEX
N8N_PUBLIC_URL=http://localhost:5678
GENERIC_TIMEZONE=UTC
